http://localhost:8080 {

    route /api/* {
        reverse_proxy api:8081
    }

    route /swagger-ui/* {
        reverse_proxy api:8081
    }

    route /api-docs {
        reverse_proxy api:8081
    }

    route /api-docs/* {
        reverse_proxy api:8081
    }

    route /v3/api-docs {
        reverse_proxy api:8081
    }

    route /v3/api-docs/* {
        reverse_proxy api:8081
    }

    route /oauth2/* {
        reverse_proxy api:8081
    }

    route {
        reverse_proxy http://host.docker.internal:3000
    }
}